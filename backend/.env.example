DATABASE_URL=sqlite:///./kamion.db
MEDIA_DIR=./media

# "mock" runs offline and needs no key — good for local dev, NOT for the demo.
# "anthropic" calls a real vision model and requires ANTHROPIC_API_KEY.
VISION_ADAPTER=mock
ANTHROPIC_API_KEY=
# Only needed for organization-scoped keys; workspace-scoped keys can leave this empty.
ANTHROPIC_WORKSPACE_ID=
VISION_MODEL=claude-sonnet-5

MAX_UPLOAD_MB=25
MIN_COMPARABLES=5
MAX_COMPARABLES=10
CONFORMAL_ALPHA=0.1
